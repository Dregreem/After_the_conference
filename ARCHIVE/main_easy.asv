fprintf(fid, 'Night Threshold:          %.2f V\n', PID_Params.night_threshold);
fprintf(fid, 'Sun Lost Threshold:       %.2f V\n', PID_Params.sun_lost_threshold);
fprintf(fid, 'Sun Found Threshold:      %.2f V\n', PID_Params.sun_found_threshold);
fprintf(fid, 'Lock Threshold:           %.2f deg\n\n', PID_Params.lock_threshold);

fprintf(fid, 'GENERATED FILES\n');
fprintf(fid, '───────────────────────────────────────────────────────────────\n');
fprintf(fid, '01_System_Performance.png\n');
fprintf(fid, '02_LDR_Sensor_Analysis.png\n');

yline(PID_Params.sun_lost_threshold, 'r--', sprintf('Lost (%.1fV)', PID_Params.sun_lost_threshold));
yline(PID_Params.sun_found_threshold, 'g--', sprintf('Found (%.1fV)', PID_Params.sun_found_threshold));

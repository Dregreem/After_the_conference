fprintf(fid, 'ADVANCED METRICS\n');
fprintf(fid, '───────────────────────────────────────────────────────────────\n');
fprintf(fid, 'Settling Time:            %.2f seconds\n', settling_time);
fprintf(fid, 'Rise Time (90%%):          %.2f seconds\n', rise_time);
